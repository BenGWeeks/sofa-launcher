[Unit]
Description=Sofa Launcher: update a container to its newer image (one request)

[Service]
# An account in the docker group. Not the TV user, and not a login account. It must be able to
# read the compose files (and .env) of the stacks whose services set  sofa.update: "true".
User=services
ExecStart=/usr/local/sbin/sofa-container-restart update
Environment=SOFA_PEER=%i
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Downloading an image can take minutes.
RuntimeMaxSec=1300
NoNewPrivileges=yes
ProtectSystem=full
# Read-only, not hidden: compose files and registry logins (~/.docker) may live under /home.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Docker pulls the image itself; this only talks to Docker's own socket.
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
UMask=0077
TasksMax=64
